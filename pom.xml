<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.chessping</groupId>
  <artifactId>PingEchecPong</artifactId>
  <packaging>jar</packaging>
  <version>1.0-SNAPSHOT</version>
  <name>PingEchecPong</name>
  <url>http://maven.apache.org</url>
  <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <javafx.version>20</javafx.version>
    </properties>
  <dependencies>
    <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${javafx.version}</version>
    </dependency>
    <!-- Jakarta EE API (pour les annotations EJB/JPA) -->
    <dependency>
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-api</artifactId>
        <version>10.0.0</version>
        <scope>provided</scope>
    </dependency>

    <!-- WildFly Client JAR (copié depuis bin/client/jboss-client.jar) -->
    <dependency>
        <groupId>org.wildfly</groupId>
        <artifactId>wildfly-client</artifactId>
        <version>37.0.1</version>
        <scope>system</scope>
        <systemPath>${project.basedir}/lib/jboss-client.jar</systemPath>
    </dependency>

    <!-- JAR client du backend EJB (contient GameConfigRemote + GameConfigDTO) -->
    <dependency>
        <groupId>com.chessping.ejb</groupId>
        <artifactId>chess-ejb-client</artifactId>
        <version>1.0-SNAPSHOT</version>
    </dependency>
  </dependencies>
  <build>
      <plugins>
          <!-- Maven Compiler Plugin -->
          <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-compiler-plugin</artifactId>
              <version>3.11.0</version>
              <configuration>
                  <source>17</source>
                  <target>17</target>
              </configuration>
          </plugin>
          
          <!-- JavaFX Maven Plugin -->
          <plugin>
              <groupId>org.openjfx</groupId>
              <artifactId>javafx-maven-plugin</artifactId>
              <version>0.0.8</version>
              <configuration>
                  <mainClass>com.chessping.ChessPingApp</mainClass>
                  <!-- Ajouter le JAR client WildFly au classpath -->
                  <options>
                      <option>-cp</option>
                      <option>${project.basedir}/lib/jboss-client.jar</option>
                  </options>
              </configuration>
          </plugin>
      </plugins>
  </build>
</project>
